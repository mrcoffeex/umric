APP_NAME=UMRIC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# In production, set FILESYSTEM_DISK=s3 and fill in AWS credentials below
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="support@umdcric.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend API key (https://resend.com/api-keys). Domain for MAIL_FROM_ADDRESS must be verified in Resend.
RESEND_API_KEY=

# Optional SMTP fallback (unused when MAIL_MAILER=resend)
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null

# Public contact form inbox (alias: CONTACT_MAIL_TO).
MAIL_CONTACT_TO="support@umdcric.com"

# Production baseline seed (php artisan db:seed --class=ProductionSeeder --force)
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_EMAIL="admin@umdcric.com"
SEED_ADMIN_PASSWORD="ChangeMe!Admin123"
# SEED_CLASS_PROGRAM=BSIT
# SEED_CLASS_YEAR_LEVEL=4
# SEED_CLASS_SECTION=A
# SEED_CLASS_SCHOOL_YEAR=2025-2026
# SEED_CLASS_SEMESTER=1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# UI brand colors (Vite inlines on build; use #hex for broadest support)
# Official UM Digos College tokens from digos.umindanao.edu.ph
# Leave unset to use defaults in resources/css/app.css
VITE_BRAND_PRIMARY="#BE0002"
VITE_BRAND_ON_PRIMARY="#ffffff"
VITE_BRAND_SECONDARY="#FFB600"
# White text on solid gold CTAs (matches UMDC buttons)
VITE_BRAND_ON_SECONDARY="#ffffff"
# Focus rings, Inertia top progress — defaults to VITE_BRAND_PRIMARY if empty
# VITE_BRAND_RING="#BE0002"
# Subtle panels/muted areas (optional)
# VITE_BRAND_MUTED="#FAF9FB"
# VITE_BRAND_ON_MUTED="#000000"

# File upload limit in megabytes (must match public/.htaccess and public/.user.ini).
UPLOAD_MAX_SIZE_MB=25
VITE_UPLOAD_MAX_SIZE_MB="${UPLOAD_MAX_SIZE_MB}"
